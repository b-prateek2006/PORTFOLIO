# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Contact form (https://resend.com -> API Keys)
RESEND_API_KEY=
# Where enquiries are delivered
CONTACT_TO_EMAIL=
# Optional. Needs a domain verified in Resend. Default: Portfolio <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# Optional. Your live URL, used for SEO / share previews (e.g. https://prateek.in)
NEXT_PUBLIC_SITE_URL=
